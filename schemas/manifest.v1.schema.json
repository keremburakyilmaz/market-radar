{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-data.keremburakyilmaz.com/schemas/manifest.v1.schema.json",
  "title": "Market Radar publication manifest v1",
  "description": "A small mutable pointer to one immutable, integrity-checked Market Radar snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "publishedAt",
    "snapshot"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "publishedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "path",
        "generatedAt",
        "validUntil",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/snapshotId"
        },
        "path": {
          "type": "string",
          "minLength": 114,
          "maxLength": 114,
          "pattern": "^v1/snapshots/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z-[a-f0-9]{64}\\.json$"
        },
        "generatedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "snapshotId": {
      "type": "string",
      "minLength": 19,
      "maxLength": 19,
      "pattern": "^mr-[0-9]{8}t[0-9]{6}z$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  }
}
